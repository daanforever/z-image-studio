# Copy to .env — the app loads it on startup (does not override existing env).

# Telemetry is off by default. Uncomment both to opt in:
# GRADIO_ANALYTICS_ENABLED=True
# HF_HUB_DISABLE_TELEMETRY=0

# HF_HUB_OFFLINE=0
# ZIMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
# ZIMAGE_LORA_DIR=
# ZIMAGE_PORT=43127
# ZIMAGE_OUTPUTS=./outputs
